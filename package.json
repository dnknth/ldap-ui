{
  "name": "ldap-ui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s generate type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "generate": "openapi-ts -i tests/resources/openapi.json -o ./src/generated",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@vueuse/core": "latest",
    "font-awesome": "^4.7.0",
    "vue": "latest"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "latest",
    "@tsconfig/node24": "latest",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/eslint-config-prettier": "latest",
    "@vue/eslint-config-typescript": "latest",
    "@vue/tsconfig": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "npm-run-all2": "latest",
    "prettier": "latest",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "latest",
    "vite-plugin-compression": "latest",
    "vitest": "^5.0.2",
    "vue-tsc": "latest"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
